# Server
NODE_ENV=development
PORT=4000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/my-app?schema=public"

# JWT Secrets (use long random strings in production)
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret-min-32-chars"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS (comma-separated allowed origins, or * for development)
CORS_ORIGIN="*"

